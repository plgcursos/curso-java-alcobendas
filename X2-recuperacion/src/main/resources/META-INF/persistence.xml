<?xml version="1.0" encoding="UTF-8"?>
<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
    version="3.0">
    
    	<persistence-unit name="recup" transaction-type="RESOURCE_LOCAL">
		
		<class>es.cursoalcobendas.recuperacion.modelo.Cliente</class>
		<class>es.cursoalcobendas.recuperacion.modelo.Cuenta</class>
		<class>es.cursoalcobendas.recuperacion.modelo.Movimiento</class>
		<class>es.cursoalcobendas.recuperacion.modelo.Tarjeta</class>
		
		<properties>
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />
			<property name="hibernate.highlight_sql" value="true" />
			
			<property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3366/92_ex_rec_banco"/>
			<property name="jakarta.persistence.jdbc.user" value="root"/>
			<property name="jakarta.persistence.jdbc.password" value="root"/>
			<property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
		</properties>
	</persistence-unit>

</persistence>
