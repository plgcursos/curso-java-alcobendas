<?xml version="1.0" encoding="UTF-8"?>
<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
    version="3.0">
    
	<persistence-unit name="tienda" transaction-type="RESOURCE_LOCAL">
	
		<class>es.cursoalcobendas.tienda.modelo.Fabricante</class>
		<class>es.cursoalcobendas.tienda.modelo.Producto</class>
	
		<properties>
<!-- 			<property name="hibernate.dialect" value="org.hibernate.dialect.MySQL5Dialect" /> -->
			<!--  
	 		<property name="hibernate.hbm2ddl.auto" value="false" />
	 		<property name="hibernate.hbm2ddl.auto" value="create" />
			-->
<!-- 			<property name="hibernate.connection.pool_size" value="8" /> -->
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />
			<property name="hibernate.highlight_sql" value="true" />
			<property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3366/04_tienda"/>
			<property name="javax.persistence.jdbc.user" value="root"/>
			<property name="javax.persistence.jdbc.password" value="root"/>
			<property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
		</properties>
	</persistence-unit>
</persistence>
